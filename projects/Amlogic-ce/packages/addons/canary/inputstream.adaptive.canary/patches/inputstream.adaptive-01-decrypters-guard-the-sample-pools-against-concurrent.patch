   m_fragmentPool[poolId].m_nalLengthSize = 99;
   m_fragmentPool[poolId].m_key.clear();
 }
@@ -575,6 +581,20 @@ AP4_Result CWVCencSingleSampleDecrypter::DecryptSampleData(AP4_UI32 poolId,
     return AP4_SUCCESS;
   }
 
+  // a renewal is a license request, keep it out of the pool lock. The video decoder renews
+  // for a secure path stream
+  bool isRenewalHere{true};
+#ifndef TARGET_WEBOS
+  {
+    std::lock_guard<std::mutex> lock(m_poolMutex);
+    isRenewalHere = !m_fragmentPool[poolId].capabilities.HasFlag(Capabilities::SECURE_PATH);
+  }
+#endif
+  if (isRenewalHere)
+    CheckLicenseRenewal();
+
+  std::lock_guard<std::mutex> lock(m_poolMutex);
+
   FINFO& fragInfo(m_fragmentPool[poolId]);
 
   if (fragInfo.capabilities.HasFlag(Capabilities::SECURE_PATH)) //we can not decrypt only
@@ -659,8 +679,6 @@ AP4_Result CWVCencSingleSampleDecrypter::DecryptSampleData(AP4_UI32 poolId,
     CdmDecryptedBlock cdmOut;
     cdmOut.SetDecryptedBuffer(&buf);
 
-    CheckLicenseRenewal();
-
     cdm::Status ret = m_cdmAdapter->GetCDM()->Decrypt(cdmIn, &cdmOut, ToCdmStreamType(streamType));
     if (ret != cdm::kSuccess)
     {
@@ -771,7 +789,6 @@ AP4_Result CWVCencSingleSampleDecrypter::DecryptSampleData(AP4_UI32 poolId,
     CdmDecryptedBlock cdmOut;
     cdmOut.SetDecryptedBuffer(&buf);
 
-    CheckLicenseRenewal();
     ret = m_cdmAdapter->GetCDM()->Decrypt(cdmIn, &cdmOut, ToCdmStreamType(streamType));
 
     if (ret == cdm::Status::kSuccess)
