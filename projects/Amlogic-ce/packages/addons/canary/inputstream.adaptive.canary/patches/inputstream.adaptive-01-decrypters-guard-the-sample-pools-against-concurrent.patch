From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: matthane <matthan.evans@icloud.com>
Date: Tue, 10 Nov 2026 00:43:41 -0600
Subject: [PATCH 01/10] [decrypters] Guard the sample pools against concurrent
 readers

All stream readers of a DRM session share its sample pools and the
Widevine decrypt buffers. A stream opened during playback adds a pool on
the player thread while another stream's reader decrypts on the thread
pool, so the pool could be reallocated under that reader.
---
 .../ClearKeyCencSingleSampleDecrypter.cpp     |  8 +++++++
 .../ClearKeyCencSingleSampleDecrypter.h       |  3 +++
 .../widevine/WVCencSingleSampleDecrypter.cpp  | 23 ++++++++++++++++---
 .../widevine/WVCencSingleSampleDecrypter.h    |  2 ++
 .../WVCencSingleSampleDecrypter.cpp           |  9 ++++++++
 .../WVCencSingleSampleDecrypter.h             |  3 +++
 6 files changed, 45 insertions(+), 3 deletions(-)

diff --git a/src/decrypters/clearkey/ClearKeyCencSingleSampleDecrypter.cpp b/src/decrypters/clearkey/ClearKeyCencSingleSampleDecrypter.cpp
index 8deb5d0d94..474a4e8720 100644
--- a/src/decrypters/clearkey/ClearKeyCencSingleSampleDecrypter.cpp
+++ b/src/decrypters/clearkey/ClearKeyCencSingleSampleDecrypter.cpp
@@ -110,6 +110,8 @@ bool CClearKeyCencSingleSampleDecrypter::HasKeyId(const std::vector<uint8_t>& ke
 
 AP4_UI32 CClearKeyCencSingleSampleDecrypter::AddPool()
 {
+  std::lock_guard<std::mutex> lock(m_poolMutex);
+
   const AP4_UI32 poolId = static_cast<AP4_UI32>(m_pool.size());
 
   m_pool.emplace(poolId, PINFO());
@@ -119,6 +121,8 @@ AP4_UI32 CClearKeyCencSingleSampleDecrypter::AddPool()
 
 void CClearKeyCencSingleSampleDecrypter::RemovePool(AP4_UI32 poolId)
 {
+  std::lock_guard<std::mutex> lock(m_poolMutex);
+
   m_pool.erase(poolId);
 }
 
@@ -130,6 +134,8 @@ AP4_Result CClearKeyCencSingleSampleDecrypter::SetFragmentInfo(
     DRM::Capabilities flags,
     CryptoInfo cryptoInfo)
 {
+  std::lock_guard<std::mutex> lock(m_poolMutex);
+
   if (!STRING::KeyExists(m_pool, poolId))
   {
     LOG::LogF(LOGERROR, "Cannot set fragment info, the pool id %u dont exist", poolId);
@@ -170,6 +176,8 @@ AP4_Result CClearKeyCencSingleSampleDecrypter::DecryptSampleData(
     const AP4_UI32* bytesOfEncryptedData,
     DRM::DRMMediaType streamType)
 {
+  std::lock_guard<std::mutex> lock(m_poolMutex);
+
   if (m_pool.empty())
   {
     LOG::LogF(LOGERROR, "Cannot decrypt data, the pool is empty");
