+
   for (size_t i(0); i < m_fragmentPool.size(); ++i)
     if (m_fragmentPool[i].m_nalLengthSize == 99)
     {
@@ -485,6 +489,8 @@ AP4_UI32 CWVCencSingleSampleDecrypter::AddPool()
 
 void CWVCencSingleSampleDecrypter::RemovePool(AP4_UI32 poolId)
 {
