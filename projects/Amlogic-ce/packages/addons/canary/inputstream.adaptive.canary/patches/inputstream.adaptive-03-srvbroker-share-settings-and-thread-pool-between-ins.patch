From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: matthane <matthan.evans@icloud.com>
Date: Mon, 9 Nov 2026 21:56:25 -0600
Subject: [PATCH 03/10] [SrvBroker] Share settings and thread pool between
 instances

The settings and the global thread pool were recreated by each new
instance and destroyed by each Close, so one instance could pull them
from under another that was still playing.
---
 src/SrvBroker.cpp           | 16 ++++++++++++----
 src/SrvBroker.h             | 12 ++++++++----
 src/main.cpp                | 11 +++++++----
 src/main.h                  |  1 +
 src/test/CMakeLists.txt     |  1 +
 src/test/TestDASHTree.cpp   |  3 ++-
 src/test/TestHLSTree.cpp    |  3 ++-
 src/test/TestSmoothTree.cpp |  3 ++-
 src/utils/ThreadPool.cpp    |  3 +++
 9 files changed, 38 insertions(+), 15 deletions(-)

diff --git a/src/SrvBroker.cpp b/src/SrvBroker.cpp
index 03ea8063e8..f7ac278246 100644
--- a/src/SrvBroker.cpp
+++ b/src/SrvBroker.cpp
@@ -9,18 +9,26 @@
 #include "SrvBroker.h"
 
 #include "CompSettings.h"
+#include "utils/ThreadPool.h"
 
 using namespace ADP;
 
 CSrvBroker::CSrvBroker() = default;
 CSrvBroker::~CSrvBroker() = default;
 
-void CSrvBroker::Initialize()
+void CSrvBroker::Acquire()
 {
-  m_compSettings = std::make_unique<SETTINGS::CCompSettings>();
+  std::lock_guard<std::mutex> lock(m_mutex);
+  if (m_refCount++ == 0)
+    m_compSettings = std::make_unique<SETTINGS::CCompSettings>();
 }
 
-void CSrvBroker::Deinitialize()
+void CSrvBroker::Release()
 {
-  m_compSettings.reset();
+  std::lock_guard<std::mutex> lock(m_mutex);
+  if (--m_refCount == 0)
+  {
+    UTILS::THREAD::GlobalThreadPool.Reset();
+    m_compSettings.reset();
+  }
 }
diff --git a/src/SrvBroker.h b/src/SrvBroker.h
index bed186e7c1..c6187d6319 100644
--- a/src/SrvBroker.h
+++ b/src/SrvBroker.h
@@ -15,6 +15,7 @@
 #endif
 
 #include <memory>
+#include <mutex>
 
 // forward
 namespace ADP::SETTINGS
@@ -32,9 +33,9 @@ public:
   void operator=(const CSrvBroker&) = delete; // Not assignable
 
   /*
-   * \brief Initialize service broker components, when the add-on is created.
+   * \brief Initialize service broker components, when the first add-on instance is created.
    */
-  void Initialize();
+  void Acquire();
 
   static CSrvBroker* GetInstance()
   {
@@ -43,9 +44,10 @@ public:
   }
 
   /*
-   * \brief Deinitialize service broker components, when the add-on is terminated.
+   * \brief Deinitialize service broker components and stop the global thread pool,
+   *        when the last add-on instance is destroyed.
    */
-  void Deinitialize();
+  void Release();
 
   /*
    * \brief Get settings component, to manage add-on XML settings.
@@ -60,4 +62,6 @@ private:
   ~CSrvBroker();
 
   std::unique_ptr<ADP::SETTINGS::CCompSettings> m_compSettings;
+  std::mutex m_mutex;
+  int m_refCount{0};
 };
diff --git a/src/main.cpp b/src/main.cpp
index 1c6e2c83d5..9c37b04663 100644
--- a/src/main.cpp
+++ b/src/main.cpp
@@ -13,7 +13,6 @@
 #include "SrvBroker.h"
 #include "Stream.h"
 #include "utils/GUIUtils.h"
-#include "utils/ThreadPool.h"
 #include "utils/log.h"
 
 using namespace PLAYLIST;
@@ -22,7 +21,13 @@ using namespace SESSION;
 CInputStreamAdaptive::CInputStreamAdaptive(const kodi::addon::IInstanceInfo& instance)
   : CInstanceInputStream(instance)
 {
-  CSrvBroker::GetInstance()->Initialize();
+  CSrvBroker::GetInstance()->Acquire();
+}
+
+CInputStreamAdaptive::~CInputStreamAdaptive()
+{
+  m_session = nullptr;
+  CSrvBroker::GetInstance()->Release();
 }
 
 ADDON_STATUS CInputStreamAdaptive::CreateInstance(const kodi::addon::IInstanceInfo& instance,
@@ -57,8 +62,6 @@ void CInputStreamAdaptive::Close(void)
 {
   LOG::Log(LOGDEBUG, "Close()");
   m_session = nullptr;
-  UTILS::THREAD::GlobalThreadPool.Reset();
-  CSrvBroker::GetInstance()->Deinitialize();
 }
 
 bool CInputStreamAdaptive::GetStreamIds(std::vector<unsigned int>& ids)
