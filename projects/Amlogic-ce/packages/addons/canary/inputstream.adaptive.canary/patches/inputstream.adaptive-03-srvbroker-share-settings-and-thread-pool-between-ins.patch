 void UTILS::THREAD::ThreadPool::Reset()
 {
   Stop();
+
+  std::lock_guard lock(m_mutex);
   m_activeExecutors = 0;
   m_executors.clear();
+  m_taskQueue = {};
   m_isStopped = false;
 }
 
