+
+TEST_F(DASHTreeTest, ChooserMaxRepresentationIgnoresBandwidth)
+{
+  auto adpSet = PLAYLIST::CAdaptationSet::MakeUniquePtr();
+  adpSet->SetStreamType(PLAYLIST::StreamType::VIDEO);
+
+  const std::vector<std::tuple<int, int, uint32_t>> reprs{
+      {640, 360, 1000000}, {1280, 720, 3000000}, {1920, 1080, 6000000}, {3840, 2160, 16000000}};
+  for (const auto& [width, height, bandwidth] : reprs)
+  {
+    auto repr = PLAYLIST::CRepresentation::MakeUniquePtr(adpSet.get());
+    repr->SetResWidth(width);
+    repr->SetResHeight(height);
+    repr->SetBandwidth(bandwidth);
+    adpSet->AddRepresentation(repr);
+  }
+
+  m_reprChooser->OnUpdateScreenRes({1920, 1080, 3840, 2160});
+  m_reprChooser->PostInit();
+  m_reprChooser->SetDownloadSpeed(250000);
+
+  PLAYLIST::CRepresentation* repr = m_reprChooser->GetRepresentation(adpSet.get());
+  EXPECT_EQ(repr->GetHeight(), 360);
+  EXPECT_EQ(m_reprChooser->GetMaxRepresentation(adpSet.get(), repr)->GetHeight(), 1080);
+}
