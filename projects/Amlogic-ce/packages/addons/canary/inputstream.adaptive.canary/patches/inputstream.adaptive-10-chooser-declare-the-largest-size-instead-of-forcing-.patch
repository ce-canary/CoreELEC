+  // From bandwidth take in consideration:
+  // 90% of bandwidth for video - 10 % for other
+  if (streamType == StreamType::VIDEO)
+    return static_cast<uint32_t>(bandwidth * 0.9);
+  else
+    return static_cast<uint32_t>(bandwidth * 0.1);
