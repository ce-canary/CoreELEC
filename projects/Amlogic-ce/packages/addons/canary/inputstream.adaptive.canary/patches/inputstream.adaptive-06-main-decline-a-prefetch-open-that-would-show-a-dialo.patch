   void Dispose();
 
+  /*!
+   * \brief Set whether the engine works for a prefetch open, which must not show a dialog.
+   * \param isPrefetch True for a prefetch open
+   */
+  void SetPrefetch(bool isPrefetch) { m_isPrefetch = isPrefetch; }
+
+  /*!
+   * \brief Get the error that would have shown a dialog during a prefetch open.
+   * \return The error message, otherwise no value
+   */
