   return it != m_drms.cend() ? it->drm : nullptr;
 }
 
+void DRM::CDRMEngine::ErrorDialog(const std::string& msg)
+{
+  if (!m_isPrefetch)
+    GUI::ErrorDialog(msg);
+  else if (!m_prefetchError)
+    m_prefetchError = msg;
+}
+
 void DRM::CDRMEngine::Dispose()
 {
   LOG::Log(LOGDEBUG, "Dispose DRM Engine");
diff --git a/src/decrypters/DrmEngine.h b/src/decrypters/DrmEngine.h
