From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: matthane <matthan.evans@icloud.com>
Date: Mon, 9 Nov 2026 22:00:28 -0600
Subject: [PATCH 06/10] [main] Decline a prefetch open that would show a dialog

Kodi can open the next playlist item while the current one still plays.
Such an open would show its error dialogs and the ask-quality chooser
over the playing item.
---
 src/Session.cpp                | 24 ++++++++++++++++++++----
 src/Session.h                  |  8 ++++++--
 src/common/Chooser.h           |  6 ++++++
 src/common/ChooserAskQuality.h |  2 ++
 src/decrypters/DrmEngine.cpp   | 20 ++++++++++++++------
 src/decrypters/DrmEngine.h     | 17 +++++++++++++++++
 src/main.cpp                   | 13 ++++++++++---
 7 files changed, 75 insertions(+), 15 deletions(-)

diff --git a/src/Session.cpp b/src/Session.cpp
index 4efd63e11a..a17c0f03e2 100644
--- a/src/Session.cpp
+++ b/src/Session.cpp
@@ -116,11 +116,17 @@ void SESSION::CSession::DeleteStreams()
 +---------------------------------------------------------------------*/
 
 SResult SESSION::CSession::Initialize(std::string manifestUrl,
-                                     const ADP::RESOURCES::ScreenInfo& screenInfo)
+                                     const ADP::RESOURCES::ScreenInfo& screenInfo,
+                                     bool isPrefetch)
 {
   m_reprChooser =
       CHOOSER::CreateRepresentationChooser(m_kodiProps.GetChooserProps(), screenInfo);
 
+  if (isPrefetch && m_reprChooser->IsInteractive())
+    return SResult::Error("The prefetch is not supported with the ask quality stream selection");
+
+  m_drmEngine.SetPrefetch(isPrefetch);
+
   switch (CSrvBroker::GetSettings().GetMediaType())
   {
     case 1:
@@ -149,6 +155,8 @@ SResult SESSION::CSession::Initialize(std::string manifestUrl,
     manifestHeaders["challengeB64"] = STRING::URLEncode(session.challenge);
     manifestHeaders["sessionId"] = session.id;
   }
+  if (m_drmEngine.GetPrefetchError())
+    return SResult::Error(*m_drmEngine.GetPrefetchError());
 
   URL::RemovePipePart(manifestUrl); // No pipe char uses, must be used Kodi properties only
 
@@ -189,8 +197,15 @@ SResult SESSION::CSession::Initialize(std::string manifestUrl,
   m_adaptiveTree->PostOpen();
   m_reprChooser->PostInit();
 
-  InitializePeriod();
+  InitializePeriod(isPrefetch);
+
+  if (m_drmEngine.GetPrefetchError())
+    return SResult::Error(*m_drmEngine.GetPrefetchError());
+  if (isPrefetch && m_streams.empty())
+    return SResult::Error("No stream can be played");
 
+  // streams open once the item plays, so their errors show
+  m_drmEngine.SetPrefetch(false);
   return SResultCode::OK;
 }
 
@@ -295,7 +310,7 @@ bool SESSION::CSession::CheckPlayableStreams(PLAYLIST::CPeriod* period)
   return true;
 }
 
-void SESSION::CSession::InitializePeriod()
+void SESSION::CSession::InitializePeriod(bool isPrefetch /* = false */)
 {
   if (m_adaptiveTree->IsChangingPeriod())
   {
@@ -409,7 +424,8 @@ void SESSION::CSession::InitializePeriod()
   {
     LOG::LogF(LOGERROR,
               "No stream can be played, common causes: resolution limits or HDCP problem");
-    GUI::ErrorDialog(GUI::GetLocalizedString(30309));
+    if (!isPrefetch)
+      GUI::ErrorDialog(GUI::GetLocalizedString(30309));
   }
 
   // Ensure that video streams are always placed before all other types
