diff --git a/src/main.cpp b/src/main.cpp
index 9c37b04663..9dae755895 100644
--- a/src/main.cpp
+++ b/src/main.cpp
@@ -47,11 +47,18 @@ bool CInputStreamAdaptive::Open(const kodi::addon::InputstreamProperty& props)
 
   m_session = std::make_shared<CSession>(props.GetProperties());
 
-  SResult ret = m_session->Initialize(props.GetURL(), m_screenInfo);
+  SResult ret = m_session->Initialize(props.GetURL(), m_screenInfo, props.IsPrefetch());
   if (ret.IsFailed())
   {
-    LOG::Log(LOGERROR, ret.Message().c_str());
-    UTILS::GUI::ErrorDialog(ret.Message());
+    if (props.IsPrefetch())
+    {
+      LOG::Log(LOGINFO, "Prefetch declined: %s", ret.Message().c_str());
+    }
+    else
+    {
+      LOG::Log(LOGERROR, ret.Message().c_str());
+      UTILS::GUI::ErrorDialog(ret.Message());
+    }
     m_session = nullptr;
     return false;
   }
